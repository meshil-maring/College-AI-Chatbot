+
+
+def checked(query):
+    result = sql(query)
+    if result.returncode:
+        raise RuntimeError(result.stderr)
+    return result.stdout.strip()
+
+
+def quote(value):
+    return "'" + str(value).replace("'", "''") + "'"
+
+
+def main(argv=None):
