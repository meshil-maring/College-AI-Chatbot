+            log.write(json.dumps(["guard-subprocess", *argv]) + "\n")
+        return fake(argv, **kwargs)
+    with patch("subprocess.run", side_effect=run), patch("subprocess.Popen", side_effect=AssertionError("Guard Popen reached")):
+        guard.main(argv[1:])
+
+
