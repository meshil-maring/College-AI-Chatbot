+        raise RuntimeError('Disposable target must be configured before SQL calls')
+    return command(
+        [
+            "docker",
+            "exec",
+            "-i",
+            CONTAINER,
+            "psql",
+            "-U",
+            "postgres",
+            "-d",
+            "postgres",
+            "-v",
+            "ON_ERROR_STOP=1",
+            "-At",
+        ],
+        input=query,
+    )
