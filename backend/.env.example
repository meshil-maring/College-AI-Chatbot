# ---------------------------------------------------------------------------
# Deployment configuration (Phase 6.15.8) — non-secret; safe to document.
#
# ENVIRONMENT: "development" (default), "dev", "local", "test", "testing" are
#   the only values that allow DEV_TEST_MODE=true. Anything else (production,
#   prod, staging, an empty value, a typo, ...) is treated as a deployment
#   environment: DEV_TEST_MODE=true then refuses to start, missing required
#   Supabase configuration stops startup, and DEBUG=true stops startup.
# DEBUG: gates chat timing diagnostics. Must be "false" in any deployment.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
# Required in deployments. Use comma-separated public API host names; never "*".
# Local development defaults to localhost, 127.0.0.1, and testserver when empty.
ALLOWED_HOSTS=
# Empty means enabled only in local development/testing and disabled elsewhere.
API_DOCS_ENABLED=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>
SUPABASE_SECRET_KEY=<your-service-role-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=documents

MAX_UPLOAD_SIZE_MB=50

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# DEVELOPMENT / TESTING ONLY.
# Enables the dev-only password recovery/reset endpoints (app/api/dev_auth.py)
# and the matching frontend UI. Must stay "false" (the default) everywhere
# except a local development/testing environment. NEVER set to "true" in
# production or for the final demo.
DEV_TEST_MODE=false

# Invitation email delivery. Local/development uses the in-memory provider and
# test/testing uses deterministic capture regardless of these values. A
# deployment must explicitly select Mailgun and supply its secrets through
# backend secret configuration. Placeholders below are not credentials.
EMAIL_PROVIDER=local
EMAIL_FROM=no-reply@localhost
EMAIL_REPLY_TO=
EMAIL_BASE_URL=http://localhost:5173
# Legacy provider-neutral setting retained for compatibility; Mailgun uses the
# explicit MAILGUN_API_KEY below.
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
EMAIL_PROVIDER_MAX_RETRIES=2
EMAIL_PROVIDER_RETRY_BASE_SECONDS=0.25
EMAIL_PROVIDER_RETRY_CAP_SECONDS=2

# Durable invitation-email outbox. Generate a Fernet key for deployments and
# provide it through backend secret configuration; never commit the value.
EMAIL_OUTBOX_TOKEN_ENCRYPTION_KEY=
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_LOCK_SECONDS=120
EMAIL_OUTBOX_RETRY_LIMIT=3

# Mailgun production transport and verified delivery webhook. Choose the US
# origin below or https://api.eu.mailgun.net for an EU-region sending domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_WEBHOOK_TOLERANCE_SECONDS=900
